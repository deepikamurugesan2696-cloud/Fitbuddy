# Copy this file to .env and add your Gemini API key.
GEMINI_API_KEY=YOUR__REAL_KEY_HERE

# Current model defaults. Change only if your Google AI account exposes another model.
GEMINI_WORKOUT_MODEL=gemini-2.5-pro
GEMINI_TIP_MODEL=gemini-3.8-flash

# SQLite database file
DATABASE_URL=sqlite:///./data/fitbuddy.db

# Optional admin token. If blank, the dashboard is available at /view-all-users for local demo use.
ADMIN_TOKEN=

# Application settings
APP_NAME=FitBuddy
DEBUG=true
